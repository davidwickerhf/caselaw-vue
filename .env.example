# ── API Configuration ──
# Optional public API link shown in the app header. Browser API calls use
# same-origin /api/** and are proxied through Nuxt/Nitro.
NUXT_PUBLIC_API_BASE_URL=

# Server-only backend API URL used by the Nuxt proxy.
NUXT_API_BACKEND_URL=https://api.caselawexplorer.tech

# Bearer token for requests proxied to the backend API. This is server-only.
# Prefer NUXT_API_BEARER_TOKEN in deployed environments; TOKEN is also supported
# for local compatibility.
NUXT_API_BEARER_TOKEN=
