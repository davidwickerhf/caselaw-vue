# ── API Configuration ──
# Backend API base URL. All /api/** requests from the browser are proxied
# through Nuxt/Nitro to this URL, avoiding CORS entirely.
#   Dev default:  http://localhost:3000
#   Production:   https://api.caselawexplorer.tech  (set in Vercel dashboard)
NUXT_PUBLIC_API_BASE_URL=http://localhost:3000
